{
  "name": "topiclens",
  "private": true,
  "version": "0.1.0",
  "description": "TopicLens: an interactive, explainable news recommendation prototype extending topic-centric explanations (Liu et al., ACM TORS 2024).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "train": ".venv/Scripts/python ml/train.py --train-impressions 200000",
    "train:neural": ".venv/Scripts/python ml/train_neural.py",
    "export": ".venv/Scripts/python ml/build_app_data.py"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/caveat-brush": "^5.3.0",
    "@fontsource/domine": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
